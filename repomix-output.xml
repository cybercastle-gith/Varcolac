  <div class="sw"><div class="chip" style="background:#6B4A32"></div><div class="info"><div class="nm">Ferrugem</div><div class="hx">#6B4A32</div><div class="of">ferro forjado oxidado</div></div></div>
  <div class="sw"><div class="chip" style="background:#D9CDB4"></div><div class="info"><div class="nm">Linho Cru</div><div class="hx">#D9CDB4</div><div class="of">tecido não tingido</div></div></div>
</div>

<h3>Luz</h3>
<div class="pal">
  <div class="sw"><div class="chip" style="background:#F0C97A"></div><div class="info"><div class="nm">Chama</div><div class="hx">#F0C97A</div><div class="of">centro da vela</div></div></div>
